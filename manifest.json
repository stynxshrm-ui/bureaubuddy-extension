{
  "manifest_version": 3,
  "name": "BureauBuddy – AI letter interpreter",
  "version": "1.0.0",
  "description": "Instantly understand Swedish government letters, bills and official documents — in plain English.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://mail.google.com/*",
    "https://www.kivra.se/*",
    "https://kivra.se/*",
    "https://minmyndighetspost.se/*",
    "https://www.1177.se/*",
    "https://e-tjanster.skatteverket.se/*",
    "https://api.bureaubuddy.se/*",
    "http://localhost/*"
  ],

  "background": {
    "service_worker": "src/background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content-gmail.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.kivra.se/*",
        "https://kivra.se/*",
        "https://minmyndighetspost.se/*"
      ],
      "js": ["src/content-generic.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": []
}
